# Copy this file to .env for local non-secret configuration only.
# Never put passwords, API tokens, cookies, browser storage, or private keys here.
TEST_ENV=HOT
HOT_BASE_URL=https://hot.rx2go.ai
ADM_BASE_URL=https://adm.rx2go.ai
BRANCH_BASE_URL=https://branch.rx2go.ai

# Authentication, stage 1: gateway
# Gateway login is fixed. The rotating password must never be stored here.
RX2GO_GATEWAY_LOGIN=admin
# RX2GO_DAILY_PASSWORD is injected only for the current run.

# Authentication, stage 2: Rx2GO application
# Login may be kept as configuration; the password must remain a runtime secret.
RX2GO_APP_LOGIN=sergeyqa
# RX2GO_APP_PASSWORD must be injected by the secure runner or Windows DPAPI-backed launcher.

# Safety switch. Keep false for smoke/regression reads.
RUN_MUTATING_TESTS=false

# Optional runtime metadata for Jira reports
QA_USER=Sergey
TEST_METHOD=Automated E2E: Playwright + API/UI verification

